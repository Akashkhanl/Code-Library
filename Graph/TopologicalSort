class TopologicalSort {

    vector<int>kahnA(int n,vector<vector<int>>&adj) {
        vector<int>inDegree(n,0);

        for(int u =0;u<n;u++) {
            for(int v:adj[u]) {
                inDegree[v]++;
            }
        }
        queue<int>q;

        for(int i =0;i<n;i++) {
            if(inDegree[i]==0) {
                q.push(i);
            }
        }
        vector<int>res;

        while(!q.empty()) {
            int u = q.front();
            q.pop();
            res.push_back(u);


            for(int v:adj[u]) {
                inDegree[v]--;

                if(inDegree[v]==0) {
                    q.push(v);
                }
            }
        }
        if(res.size()!=n) return {};
        return res;

    }



};
